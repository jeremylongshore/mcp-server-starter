# Railway sets PORT for you. Locally it defaults to 3000.
PORT=3000

# Bearer token clients must send as "Authorization: Bearer <token>".
# Leave empty to turn auth off (local dev only). The Railway template
# generates one with ${{secret(32, "abcdef0123456789")}}.
MCP_AUTH_TOKEN=

# Name the server reports to MCP clients.
MCP_SERVER_NAME=mcp-server-starter
